{
  "name": "studio-log-generator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:local": "npm run compress-videos && next build",
    "start": "next start",
    "lint": "next lint",
    "parse": "python parser.py",
    "parse:force": "python parser.py --force",
    "parse:clean": "rm -f .last_parse_run.json && python parser.py --force",
    "commit": "node scripts/smart-commit.js",
    "compress-videos": "node scripts/compress-videos.js",
    "compress-videos:force": "rm -f .video-compression-cache.json && node scripts/compress-videos.js",
    "test-blob": "source venv/bin/activate && python test_blob.py",
    "upload-assets": "source venv/bin/activate && python blob_parser_with_compression.py",
    "upload-assets-basic": "source venv/bin/activate && python blob_parser.py",
    "deploy": "npm run parse && npm run upload-assets && npm run commit && npm run build:local && vercel --prod",
    "deploy:preview": "npm run parse && npm run upload-assets && npm run commit && npm run build:local && vercel",
    "publish": "npm run deploy",
    "dev:full": "npm run parse && npm run dev"
  },
  "dependencies": {
    "@primer/octicons-react": "^19.15.2",
    "@vercel/blob": "^1.1.1",
    "date-fns": "^4.1.0",
    "gray-matter": "^4.0.3",
    "next": "15.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "typescript": "^5"
  }
}
